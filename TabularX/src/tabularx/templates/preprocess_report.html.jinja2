<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 数据预处理报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; background: #ecf0f1; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-info { background: #cce5ff; color: #004085; }
    .badge-drop { background: #f8d7da; color: #721c24; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .75rem 1rem; margin: .75rem 0; border-radius: 4px; font-size: .9rem; }
    .evidence .rule { color: #7f8c8d; font-size: .85rem; margin-top: .25rem; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
    /* Mermaid 流程图样式 */
    .mermaid { background: #fff; padding: 1rem; border-radius: 6px; border: 1px solid #eee; }
    .mermaid-note { background: #f5f6fa; border: 1px dashed #bdc3c7; padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: .85rem; color: #7f8c8d; }
  </style>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  </script>
</head>
<body>
  <h1>TabularX 数据预处理报告</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 摘要</h2>

    <h3>输入 / 输出</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_features_in }}</div><div class="label">输入特征数</div></div>
      <div class="card"><div class="num">{{ data.n_features_out }}</div><div class="label">输出特征数</div></div>
      <div class="card"><div class="num">{{ data.dropped_columns | length }}</div><div class="label">丢弃列数</div></div>
      <div class="card"><div class="num">{{ data.X_train.shape[0] }}</div><div class="label">训练集样本数</div></div>
      <div class="card"><div class="num">{{ data.X_valid.shape[0] }}</div><div class="label">验证集样本数</div></div>
      <div class="card"><div class="num">{{ data.X_test.shape[0] }}</div><div class="label">测试集样本数</div></div>
    </div>

    <h3>关键结论</h3>
    <div class="conclusion">
      {% if data.dropped_columns %}
        丢弃了 <b>{{ data.dropped_columns | length }}</b> 列：<code>{{ data.dropped_columns | join(", ") }}</code>
      {% else %}
        没有列被丢弃。
      {% endif %}
      <br>
      {% if data.n_features_in != data.n_features_out %}
        特征数量从 <b>{{ data.n_features_in }}</b> 变为 <b>{{ data.n_features_out }}</b>
        （{{ "增加" if data.n_features_out > data.n_features_in else "减少" }}
        了 {{ (data.n_features_out - data.n_features_in) | abs }} 列）。
      {% else %}
        特征数量保持 <b>{{ data.n_features_out }}</b> 列不变。
      {% endif %}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：判断流程
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>② 判断流程</h2>

    <div class="mermaid">
flowchart TD
  Start([开始：接收 X, y, profile, split_result, config]) --> Slice[阶段 1：切片数据]
  Slice -->|提取 train/valid/test 索引| ColLoop[阶段 2：逐列处理]

  ColLoop --> EmptyCol{常数列或全空列？}
  EmptyCol -->|是| Drop[丢弃此列]
  EmptyCol -->|否| TextCol{文本列？}
  TextCol -->|是，handle_text=drop| Drop
  TextCol -->|是，handle_text=keep| TextError[报错：暂不支持 NLP]
  TextCol -->|否| DtCol{日期列？}
  DtCol -->|handle_datetime=drop| Drop
  DtCol -->|handle_datetime=keep| Keep[原样保留]
  DtCol -->|handle_datetime=extract| DtExtract[提取年/月/日数值特征]

  Drop --> NextCol
  TextError --> NextCol
  Keep --> NextCol
  DtExtract --> NextCol

  DtCol -->|否| NumCol{数值列？}
  NumCol -->|是| NumImpute[填补缺失值]
  NumImpute --> ScaleQuery{需要标准化？}
  ScaleQuery -->|是| SkewQuery1{分布偏斜？}
  ScaleQuery -->|否| SkewQuery2{分布偏斜？}
  SkewQuery1 -->|是| YeoJohnson[Yeo-Johnson 变换<br/>兼作标准化]
  SkewQuery1 -->|否| Scale[标准化]
  SkewQuery2 -->|是| YeoJohnson2[Yeo-Johnson 变换]
  SkewQuery2 -->|否| NoOp[无需处理]
  YeoJohnson --> NextCol
  Scale --> NextCol
  YeoJohnson2 --> NextCol
  NoOp --> NextCol

  NumCol -->|否| BoolCol{布尔列？}
  BoolCol -->|是| BoolProc["填补缺失 转 int(0/1)"]
  BoolProc --> NextCol
  BoolCol -->|否| CateCol{类别列？}
  CateCol -->|是| CateImpute[填补缺失值]
  CateImpute --> HighCard{高基数？}
  HighCard -->|unique > max_onehot_categories| HighEnc{高基数编码}
  HighEnc -->|target| TargetEncode[目标编码]
  HighEnc -->|frequency| FreqEncode[频率编码]
  HighCard -->|否| LowEnc{低基数编码}
  LowEnc -->|onehot| OneHot[OneHot 编码]
  LowEnc -->|label| LabelEncode[标签编码]
  TargetEncode --> NextCol
  FreqEncode --> NextCol
  OneHot --> NextCol
  LabelEncode --> NextCol

  CateCol -->|否| Unknown[未知类型 原样保留]
  Unknown --> NextCol

  NextCol{还有下一列？}
  NextCol -->|是| ColLoop
  NextCol -->|否| Done([完成：输出 PreprocessedData])

  classDef error fill:#f8d7da,stroke:#721c24,stroke-width:1px;
  classDef decision fill:#fff3cd,stroke:#856404,stroke-width:1px;
  class Drop,TextError error;
  class EmptyCol,TextCol,DtCol,NumCol,BoolCol,CateCol,ScaleQuery,SkewQuery1,SkewQuery2,HighCard,HighEnc,LowEnc decision;
    </div>
    <div class="mermaid-note">↑ preprocess 阶段决策流程。灰色背景节点为决策分支，红色为错误出口。</div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：逐列变换记录
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>③ 逐列变换记录</h2>

    {% set ns = namespace(n_scale=0, n_impute=0, n_encode=0, n_drop=0) %}
    {% for t in data.transforms %}
      {% if "scale" in t.action_sequence | join(" ") %}{% set ns.n_scale = ns.n_scale + 1 %}{% endif %}
      {% if "impute" in t.action_sequence | join(" ") %}{% set ns.n_impute = ns.n_impute + 1 %}{% endif %}
      {% if "encode" in t.action_sequence | join(" ") %}{% set ns.n_encode = ns.n_encode + 1 %}{% endif %}
      {% if t.dropped %}{% set ns.n_drop = ns.n_drop + 1 %}{% endif %}
    {% endfor %}

    <p class="hint">
      总计 {{ data.transforms | length }} 列 · 
      标准化 {{ ns.n_scale }} 列 · 填补 {{ ns.n_impute }} 列 · 编码 {{ ns.n_encode }} 列 · 丢弃 {{ ns.n_drop }} 列
    </p>

    <table>
      <thead>
        <tr>
          <th>列名</th>
          <th>原始 dtype</th>
          <th>原始唯一值</th>
          <th>变换动作</th>
          <th>输出特征数</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for t in data.transforms %}
        <tr>
          <td><b>{{ t.col_name }}</b></td>
          <td><code>{{ t.original_dtype }}</code></td>
          <td>{{ t.original_n_unique }}</td>
          <td>
            {% if t.dropped %}
              <span class="badge badge-drop">丢弃</span>
            {% elif t.action_sequence | length == 0 or t.action_sequence[0] == "kept" %}
              <span class="badge badge-ok">保留</span>
            {% else %}
              {% for act in t.action_sequence %}
                <span class="badge {{ 'badge-warn' if 'impute' in act else 'badge-ok' if 'scale' in act or 'yeo' in act or 'log1p' in act else 'badge-info' }}">{{ act }}</span>
              {% endfor %}
            {% endif %}
          </td>
          <td>{{ t.n_features_out }}</td>
          <td class="hint">{{ t.note or "" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：数据概况（各子集统计）
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>④ 数据概况</h2>

    <h3>输出特征名</h3>
    <p>
      {% for name in data.feature_names_out %}
        <span class="badge badge-info">{{ name }}</span>
      {% endfor %}
    </p>

    <h3>训练集描述性统计</h3>
    <table>
      <thead>
        <tr>
          <th>列名</th>
          <th>均值</th>
          <th>标准差</th>
          <th>最小值</th>
          <th>最大值</th>
        </tr>
      </thead>
      <tbody>
        {% for col_name in data.feature_names_out %}
          {% set col = data.X_train[col_name] %}
          {% if col.dtype in ['float64', 'int64', 'float32', 'int32'] %}
          <tr>
            <td>{{ col_name }}</td>
            <td>{{ "%.4f"|format(col.mean()) }}</td>
            <td>{{ "%.4f"|format(col.std()) }}</td>
            <td>{{ "%.4f"|format(col.min()) }}</td>
            <td>{{ "%.4f"|format(col.max()) }}</td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>
    <p>由 TabularX 自动生成 · Preprocess 报告</p>
  </footer>
</body>
</html>