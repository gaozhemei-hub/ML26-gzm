<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 数据划分报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-info { background: #cce5ff; color: #004085; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .75rem 1rem; margin: .75rem 0; border-radius: 4px; font-size: .9rem; }
    .evidence .rule { color: #7f8c8d; font-size: .85rem; margin-top: .25rem; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    .mermaid-note { background: #f5f6fa; border: 1px dashed #bdc3c7; padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: .85rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
    .mermaid { background: #fff; padding: 1rem; border-radius: 6px; border: 1px solid #eee; }
  </style>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  </script>
</head>
<body>
  <h1>TabularX 数据划分报告</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 摘要</h2>

    <h3>输入</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_total }}</div><div class="label">原始样本数</div></div>
      <div class="card"><div class="num">{{ data.test_size }}</div><div class="label">test_size 参数</div></div>
      <div class="card"><div class="num">{{ data.validation_size }}</div><div class="label">validation_size 参数</div></div>
    </div>

    <h3>输出</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_train }}</div><div class="label">训练集 ({{ "%.1f"|format(data.train_ratio * 100) }}%)</div></div>
      <div class="card"><div class="num">{{ data.n_valid }}</div><div class="label">验证集 ({{ "%.1f"|format(data.valid_ratio * 100) }}%)</div></div>
      <div class="card"><div class="num">{{ data.n_test }}</div><div class="label">测试集 ({{ "%.1f"|format(data.test_ratio * 100) }}%)</div></div>
    </div>

    <h3>关键结论</h3>
    <div class="conclusion">
      {% if data.stratify %}
        任务为 <b>分类任务</b>，使用了 <b>分层采样</b>（stratified split），
        保证训练/验证/测试集各类别分布与原数据一致。
      {% else %}
        任务为 <b>回归任务</b>，使用了 <b>纯随机采样</b>（random split）。
      {% endif %}
      随机种子：<code>{{ data.random_state }}</code>。
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：判断流程与证据
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>② 判断流程与证据</h2>

    <h3>2.1 判断流程图</h3>
    <div class="mermaid">
flowchart TD
  Start([开始：接收 X, y, profile, config]) --> TaskCheck{任务类型判断}
  TaskCheck -->|binary / multiclass| Stratify[使用分层采样 stratify=y]
  TaskCheck -->|regression| Random[使用纯随机采样]
  Stratify --> Phase1[阶段 1：分出测试集]
  Random --> Phase1
  Phase1 -->|stratify 失败（类别样本不足）| StratifyFail1[失败：StratifyError]
  Phase1 -->|成功| Phase2[阶段 2：从剩余部分分验证集]
  Phase2 -->|stratify 失败| StratifyFail2[失败：StratifyError]
  Phase2 -->|成功| SizeCheck{子集样本数检查}
  SizeCheck -->|任一子集 < min_samples_split| SizeFail[失败：InvalidSplitError]
  SizeCheck -->|全部达标| DistCheck{类别分布对比}
  DistCheck -->|max_shift < 0.05| Good[分布一致 ✅]
  DistCheck -->|max_shift ≥ 0.05| Warn[分布差异较大 ⚠️ 记录警告]
  Good --> Done([完成：输出 SplitResult])
  Warn --> Done
  classDef error fill:#f8d7da,stroke:#721c24,stroke-width:1px;
  classDef warning fill:#fff3cd,stroke:#856404,stroke-width:1px;
  class StratifyFail1,StratifyFail2,SizeFail error;
  class Warn warning;
    </div>
    <div class="mermaid-note">↑ split 阶段完整判断流程。</div>

    <h3>2.2 判断依据</h3>
    {% for ev in data.evidences %}
    <div class="evidence">
      <b>{{ ev.metric }}</b> = <code>{{ ev.value }}</code>
      {% if ev.note %}<span class="hint">— {{ ev.note }}</span>{% endif %}
    </div>
    {% endfor %}
  </section>

  <footer>
    <p>由 TabularX 自动生成 · 随机种子 {{ data.random_state }}</p>
  </footer>
</body>
</html>