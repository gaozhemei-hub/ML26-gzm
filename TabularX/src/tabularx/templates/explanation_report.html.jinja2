<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 可解释性与公平性报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    h3 { color: #2c3e50; margin-top: 1.5rem; }
    h4 { color: #2c3e50; margin-top: 1.2rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    .model-link { text-decoration: none; color: #2980b9; }
    .model-link:hover { text-decoration: underline; }
    .plot-grid { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0; }
    .plot-item { flex: 1; min-width: 360px; border: 1px solid #eee; border-radius: 6px; padding: .5rem; text-align: center; }
    .plot-item img { max-width: 100%; height: auto; border-radius: 4px; }
    .plot-item .caption { font-size: .85rem; color: #7f8c8d; margin-top: .25rem; }
    .badge { display: inline-block; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-info { background: #cce5ff; color: #004085; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-drop { background: #f8d7da; color: #721c24; }
    .stat-row { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0; }
    .stat-item { background: #f8f9fa; border: 1px solid #eee; border-radius: 4px; padding: .5rem .75rem; min-width: 140px; }
    .stat-item .name { font-size: .75rem; color: #7f8c8d; }
    .stat-item .val { font-size: .9rem; font-weight: 600; color: #2c3e50; }
    .mermaid { background: #fff; padding: 1rem; border-radius: 6px; border: 1px solid #eee; }
    .mermaid-note { background: #f5f6fa; border: 1px dashed #bdc3c7; padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: .85rem; color: #7f8c8d; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
  </style>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  </script>
</head>
<body>
  <p><a href="model_search.html" class="model-link" style="color: #2980b9;">← 返回模型搜索总览</a></p>
  <h1>TabularX 可解释性与公平性报告</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 摘要</h2>

    <h3>输入</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.best_model_name or "—" }}</div><div class="label">最优模型</div></div>
      {% if data.shap_available %}
      <div class="card"><div class="num">{{ data.shap_n_explain_samples }}</div><div class="label">解释样本数</div></div>
      <div class="card"><div class="num">{{ data.shap_n_features }}</div><div class="label">特征数</div></div>
      <div class="card"><div class="num">{{ "%.1f"|format(data.shap_top_k_explained_ratio * 100) }}%</div><div class="label">Top-10 累计解释力</div></div>
      {% endif %}
      {% if data.fairness_enabled %}
      <div class="card"><div class="num">{{ data.fairness_sensitive_features | length }}</div><div class="label">敏感特征数</div></div>
      {% endif %}
    </div>

    <h3>结论</h3>
    <div class="conclusion">
      {% if data.shap_available and data.fairness_enabled %}
        对最优模型 <b>{{ data.best_model_name }}</b> 执行了 SHAP 可解释性分析，
        并对 <b>{{ data.fairness_sensitive_features | length }}</b> 个敏感特征执行了公平性评估。
      {% elif data.shap_available %}
        对最优模型 <b>{{ data.best_model_name }}</b> 执行了 SHAP 可解释性分析。
        未指定敏感特征，跳过公平性评估。
      {% elif data.fairness_enabled %}
        对 <b>{{ data.fairness_sensitive_features | length }}</b> 个敏感特征执行了公平性评估。
        SHAP 可解释性不可用。
      {% else %}
        未执行任何分析。
      {% endif %}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：整体流程图（架构总览）
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>② 整体流程图</h2>
    <div class="mermaid">
flowchart TB
  Input([模型搜索结果]) --> SHAPBlock[SHAP 可解释性<br/>对最优模型]

  SHAPBlock --> Importance[特征重要性排序<br/>Top-10]
  SHAPBlock --> Viz[SHAP 可视化<br/>beeswarm / 柱状图 / waterfall]
  SHAPBlock --> Direction[特征贡献方向分析]

  Input --> FairnessBlock[公平性评估<br/>对每个敏感特征]

  FairnessBlock --> Resolve[查找 column_mappings<br/>解析预处理后列名]
  Resolve --> Dropped{已被丢弃？}
  Dropped -->|是| Skip[跳过并提示]
  Dropped -->|否| Split[按子组拆分测试集]
  Split --> GroupMetrics[计算各子组指标<br/>正类预测率 / 准确率 / TPR / FPR]
  GroupMetrics --> Diff[计算公平性差异<br/>Demographic Parity<br/>Equalized Odds TPR/FPR]
  Diff --> Threshold{超出阈值 0.1？}
  Threshold -->|是| Warn[标记潜在偏见]
  Threshold -->|否| Pass[公平性通过]

  SHAPBlock & FairnessBlock --> Report[生成可解释性与公平性报告]
</div>
<div class="mermaid-note">可解释性与公平性报告完整流程。SHAP 解释在最优模型上自动执行；公平性评估在用户指定敏感特征后执行。</div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：SHAP 可解释性分析
       ══════════════════════════════════════════════════════════ -->
  {% if data.shap_available %}
  <section>
    <h2>③ SHAP 可解释性分析</h2>

    <h3>1.1 基本信息</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.best_model_name }}</div><div class="label">最优模型</div></div>
      <div class="card"><div class="num">{{ data.shap_n_explain_samples }}</div><div class="label">解释样本数</div></div>
      <div class="card"><div class="num">{{ data.shap_n_features }}</div><div class="label">特征数</div></div>
      <div class="card"><div class="num">{{ "%.1f"|format(data.shap_top_k_explained_ratio * 100) }}%</div><div class="label">Top-10 累计解释力</div></div>
    </div>

    <div class="conclusion">
      <b>模型决策依据</b>
      <br>
      最优模型 <b>{{ data.best_model_name }}</b> 在 {{ data.shap_n_explain_samples }} 个测试样本上进行了 SHAP 解释。
      前 10 个特征累计解释了约 <b>{{ "%.1f"|format(data.shap_top_k_explained_ratio * 100) }}%</b> 的模型决策，
      说明模型决策主要受少数关键特征驱动。
    </div>

    <h3>1.2 特征重要性（Top-10）</h3>
    <table>
      <thead>
        <tr>
          <th>排名</th>
          <th>特征</th>
          <th>平均 |SHAP|</th>
          <th>解释力占比</th>
          <th>均值</th>
          <th>标准差</th>
          <th>最小值</th>
          <th>最大值</th>
        </tr>
      </thead>
      <tbody>
        {% for feat, imp in data.shap_feature_importance.items() %}
        {% if loop.index <= 10 %}
        {% set _stat = data.shap_top_k_stats.get(feat, {}) %}
        {% set _pct = imp / data.shap_sum_total * 100 if data.shap_sum_total > 0 else 0 %}
        <tr>
          <td>{{ loop.index }}</td>
          <td><b>{{ feat }}</b></td>
          <td>{{ "%.4f"|format(imp) }}</td>
          <td>{{ "%.1f"|format(_pct) }}%</td>
          <td>{{ "%.4f"|format(_stat.get('mean', 0)) }}</td>
          <td>{{ "%.4f"|format(_stat.get('std', 0)) }}</td>
          <td>{{ "%.4f"|format(_stat.get('min', 0)) }}</td>
          <td>{{ "%.4f"|format(_stat.get('max', 0)) }}</td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>

    <h3>1.3 SHAP 可视化</h3>
    <div class="plot-grid">
      {% if data.shap_has_summary %}
      <div class="plot-item">
        <img src="{{ data.shap_artifact_dir }}/{{ data.best_model_name }}_shap_summary.png" alt="SHAP Summary">
        <div class="caption">SHAP Summary（beeswarm）— 每个点代表一个样本的 SHAP 值</div>
      </div>
      {% endif %}
      {% if data.shap_has_importance %}
      <div class="plot-item">
        <img src="{{ data.shap_artifact_dir }}/{{ data.best_model_name }}_shap_importance.png" alt="SHAP 特征重要性">
        <div class="caption">特征重要性排序（平均 |SHAP| 值）</div>
      </div>
      {% endif %}
      {% if data.shap_has_waterfall %}
      <div class="plot-item">
        <img src="{{ data.shap_artifact_dir }}/{{ data.best_model_name }}_shap_waterfall.png" alt="SHAP Waterfall">
        <div class="caption">单个样本的 SHAP Waterfall 解释</div>
      </div>
      {% endif %}
    </div>

    <h3>1.4 特征贡献方向摘要</h3>
    <p class="hint">
      下表列出 Top-5 特征对预测的总体影响方向。均值 > 0 表示该特征值越高越推动预测向正类（或更高预测值），
      均值 < 0 表示该特征值越高越推动预测向负类（或更低预测值）。
    </p>
    <table>
      <thead>
        <tr>
          <th>特征</th>
          <th>平均 SHAP 值</th>
          <th>主导方向</th>
          <th>影响描述</th>
        </tr>
      </thead>
      <tbody>
        {% for feat, imp in data.shap_feature_importance.items() %}
        {% if loop.index <= 5 %}
        {% set _stat = data.shap_top_k_stats.get(feat, {}) %}
        {% set _mean = _stat.get('mean', 0) %}
        {% if _mean > 0.001 %}
          {% set _dir = "正向" %}
          {% set _desc = "值越大 → 预测值越高" if data.task_type == "regression" else "值越大 → 正类概率越高" %}
        {% elif _mean < -0.001 %}
          {% set _dir = "负向" %}
          {% set _desc = "值越大 → 预测值越低" if data.task_type == "regression" else "值越大 → 负类概率越高" %}
        {% else %}
          {% set _dir = "双向" %}
          {% set _desc = "影响方向因样本而异（均值接近零）" %}
        {% endif %}
        <tr>
          <td><b>{{ feat }}</b></td>
          <td>{{ "%.4f"|format(_mean) }}</td>
          <td><span class="badge {{ 'badge-ok' if _dir == '正向' else 'badge-warn' if _dir == '负向' else 'badge-info' }}">{{ _dir }}</span></td>
          <td class="hint">{{ _desc }}</td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>

    {% if data.shap_error %}
    <div style="background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 6px; padding: 1rem; margin-top: 1rem;">
      <b>SHAP 执行错误：</b><br>
      <span class="hint">{{ data.shap_error }}</span>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：公平性评估
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>④ 公平性评估</h2>

    {% if data.fairness_error %}
    <div style="background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 6px; padding: 1rem; margin: 1rem 0;">
      <b>公平性评估执行错误：</b><br>
      <span class="hint">{{ data.fairness_error }}</span>
    </div>

    {% elif not data.fairness_enabled %}
    <div class="conclusion" style="background: #f5f6fa; border-left-color: #95a5a6;">
      <b>未指定敏感特征</b>
      <br>
      未指定敏感特征，跳过公平性评估。可通过
      <code>FairnessConfig(sensitive_features=["列名1", "列名2"])</code>
      启用公平性审计，自动计算模型在不同子组间的性能差异和公平性指标
      （Demographic Parity、Equalized Odds）。
    </div>

    {% else %}
    <h3>4.1 配置</h3>
    <table>
      <tr><th>敏感特征</th><td>
        {% for f in data.fairness_sensitive_features %}
          <span class="badge badge-info">{{ f }}</span>
        {% endfor %}
      </td></tr>
      <tr><th>评估指标</th><td>Demographic Parity, Equalized Odds (TPR / FPR)</td></tr>
      <tr><th>差异阈值</th><td>由 FairnessConfig.dp_threshold / eo_tpr_threshold / eo_fpr_threshold 配置</td></tr>
    </table>

    {% for feat_result in data.fairness_feature_results %}
    <h3>4.2 敏感特征：{{ feat_result.feature_name }}</h3>

    {% if feat_result.is_dropped %}
    <div class="conclusion" style="background: #fef3cd; border-left-color: #ffc107;">
      <b>特征已被丢弃</b>
      <br>
      {{ feat_result.dropped_reason or "该敏感特征在预处理中被丢弃，无法进行公平性评估。" }}
    </div>
    {% else %}

    <h4>各子组指标</h4>
    <table>
      <thead>
        <tr>
          <th>子组</th>
          <th>样本数</th>
          <th>正类预测率</th>
          <th>准确率</th>
          <th>TPR（真正率）</th>
          <th>FPR（假正率）</th>
        </tr>
      </thead>
      <tbody>
        {% for g in feat_result.groups %}
        <tr>
          <td><b>{{ g.group_name }}</b></td>
          <td>{{ g.n_samples }}</td>
          <td>{{ "%.2f"|format(g.positive_rate * 100) }}%</td>
          <td>{{ "%.2f"|format(g.accuracy * 100) }}%</td>
          <td>{{ "%.2f"|format(g.tpr * 100) }}%</td>
          <td>{{ "%.2f"|format(g.fpr * 100) }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h4>公平性差异</h4>
    <table>
      <thead>
        <tr>
          <th>指标</th>
          <th>差异值</th>
          <th>是否超阈值</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% set _dp = feat_result.demographic_parity_diff or 0 %}
        {% set _dp_flag = "badge-warn" if feat_result.dp_violation else "badge-ok" %}
        <tr>
          <td><b>Demographic Parity</b></td>
          <td>{{ "%.4f"|format(_dp) }}</td>
          <td><span class="badge {{ _dp_flag }}">{{ "是" if feat_result.dp_violation else "否" }}</span></td>
          <td class="hint">各子组正类预测率的最大差异</td>
        </tr>
        {% set _tpr = feat_result.equalized_odds_tpr_diff or 0 %}
        {% set _tpr_flag = "badge-warn" if feat_result.eo_tpr_violation else "badge-ok" %}
        <tr>
          <td><b>Equalized Odds (TPR)</b></td>
          <td>{{ "%.4f"|format(_tpr) }}</td>
          <td><span class="badge {{ _tpr_flag }}">{{ "是" if feat_result.eo_tpr_violation else "否" }}</span></td>
          <td class="hint">各子组真正率的最大差异</td>
        </tr>
        {% set _fpr = feat_result.equalized_odds_fpr_diff or 0 %}
        {% set _fpr_flag = "badge-warn" if feat_result.eo_fpr_violation else "badge-ok" %}
        <tr>
          <td><b>Equalized Odds (FPR)</b></td>
          <td>{{ "%.4f"|format(_fpr) }}</td>
          <td><span class="badge {{ _fpr_flag }}">{{ "是" if feat_result.eo_fpr_violation else "否" }}</span></td>
          <td class="hint">各子组假正率的最大差异</td>
        </tr>
      </tbody>
    </table>

    {% if feat_result.dp_violation or feat_result.eo_tpr_violation or feat_result.eo_fpr_violation %}
    <div class="conclusion" style="background: #fef3cd; border-left-color: #ffc107;">
      <b>潜在偏见检测</b>
      <br>
      模型在特征 <b>{{ feat_result.feature_name }}</b> 上存在超过阈值的公平性差异，
      建议进一步审查模型对该特征的依赖情况。
    </div>
    {% else %}
    <div class="conclusion" style="background: #d4edda; border-left-color: #28a745;">
      <b>公平性通过</b>
      <br>
      模型在特征 <b>{{ feat_result.feature_name }}</b> 上的公平性差异在可接受范围内。
    </div>
    {% endif %}
    {% endif %}
    {% endfor %}
    {% endif %}
  </section>

  <footer>
    <p>由 TabularX 自动生成 · 可解释性与公平性报告</p>
  </footer>
</body>
</html>