<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 模型详情 — {{ data.run.model_name }}</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    h3 { color: #2c3e50; margin-top: 1.5rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-info { background: #cce5ff; color: #004085; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .conclusion-good { background: #d4edda; border-left: 4px solid #28a745; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .conclusion-bad { background: #f8d7da; border-left: 4px solid #dc3545; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    .chart-container { background: #fff; border: 1px solid #eee; border-radius: 6px; padding: 1rem; margin: 1rem 0; }
    .param-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .5rem; margin: 1rem 0; }
    .param-item { background: #f8f9fa; border: 1px solid #eee; border-radius: 4px; padding: .5rem .75rem; }
    .param-item .name { font-size: .8rem; color: #7f8c8d; }
    .param-item .value { font-size: .9rem; font-weight: 600; color: #2c3e50; word-break: break-all; }
    .evaluation-text { font-size: .95rem; line-height: 1.7; padding: .5rem 0; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
</head>
<body>
  <p><a href="../model_search.html" style="color: #2980b9;">← 返回总览</a></p>
  <h1>模型详情：{{ data.run.model_name }}</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：基本信息
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 基本信息</h2>
    <div class="summary">
      <div class="card"><div class="num">{{ data.run.n_trials }}</div><div class="label">Trial 次数</div></div>
      <div class="card"><div class="num">{{ "%.1f"|format(data.run.optuna_duration_seconds or 0) }}s</div><div class="label">调参耗时</div></div>
      <div class="card"><div class="num" style="font-size:1.1rem">{{ data.run.model_name }}</div><div class="label">算法</div></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：评价
       ══════════════════════════════════════════════════════════ -->
  {% if data.run.model_name == data.best_model_name %}
  <div class="conclusion-good">
    <b>🏆 最优模型（{{ data.primary_metric }} = {{ "%.4f"|format(data.run.validation_metrics.get(data.primary_metric, 0)) }}）</b>
    <div class="evaluation-text">
      该模型在验证集上取得了最佳 {{ data.primary_metric }} 表现，被选为最终模型。
      {% if data.run.test_metrics %}
      在测试集上 {{ data.primary_metric }} 为 {{ "%.4f"|format(data.run.test_metrics.get(data.primary_metric, 0)) }}，
      与验证集表现较为一致。
      {% endif %}
    </div>
  </div>
  {% elif data.run.status == "failed" %}
  <div class="conclusion-bad">
    <b>❌ 调参失败</b>
    <div class="evaluation-text">错误原因：{{ data.run.error }}</div>
  </div>
  {% else %}
    {% set best_val = data.best_validation_metrics.get(data.primary_metric, 0) %}
    {% set this_val = data.run.validation_metrics.get(data.primary_metric, 0) %}
    {% if best_val != 0 and (best_val - this_val)|abs / best_val|abs < 0.01 %}
    <div class="conclusion-good">
      <b>👍 表现与最优模型相当</b>
      <div class="evaluation-text">
        {{ data.primary_metric }} = {{ "%.4f"|format(this_val) }}，与最优模型（{{ "%.4f"|format(best_val) }}）差距在 1% 以内。
      </div>
    </div>
    {% elif best_val != 0 and (best_val - this_val)|abs / best_val|abs < 0.05 %}
    <div class="conclusion">
      <b>👌 表现略低于最优模型</b>
      <div class="evaluation-text">
        {{ data.primary_metric }} = {{ "%.4f"|format(this_val) }}，与最优模型（{{ "%.4f"|format(best_val) }}）差距在 5% 以内。
      </div>
    </div>
    {% else %}
    <div class="conclusion-bad">
      <b>⚠️ 表现显著低于最优模型</b>
      <div class="evaluation-text">
        {{ data.primary_metric }} = {{ "%.4f"|format(this_val) }}，与最优模型（{{ "%.4f"|format(best_val) }}）差距超过 5%。
      </div>
    </div>
    {% endif %}
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：调参轨迹图（仅成功模型）
       ══════════════════════════════════════════════════════════ -->
  {% if data.run.status == "success" and data.run.optuna_trials %}
  <section>
    <h2>② 调参轨迹</h2>
    <div class="chart-container">
      <canvas id="trialChart" height="300"></canvas>
    </div>
    <p class="hint">
      横轴为 Trial 序号，纵轴为主指标（{{ data.primary_metric }}）。
      每个点代表一次 trial 的验证集 {{ data.primary_metric }} 值。
      {% if data.optimization_direction == "minimize" %}值越低越好。{% else %}值越高越好。{% endif %}
    </p>
    <script>
      (function() {
        const trials = [
          {% for t in data.run.optuna_trials %}
            { number: {{ t.trial_number }}, value: {{ t.value }} },
          {% endfor %}
        ];
        const labels = trials.map(t => t.number);

        new Chart(document.getElementById('trialChart'), {
          type: 'scatter',
          data: {
            datasets: [{
              label: 'Trial',
              data: trials.map(t => ({ x: t.number, y: t.value })),
              backgroundColor: '#3498db',
              pointRadius: 5,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(ctx) {
                    return 'Trial ' + ctx.parsed.x + ': ' + ctx.parsed.y.toFixed(4);
                  }
                }
              }
            },
            scales: {
              x: { title: { display: true, text: 'Trial 序号' } },
              y: { title: { display: true, text: '{{ data.primary_metric }}' } }
            }
          }
        });
      })();
    </script>
  </section>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 4 部分：三集表现对比
       ══════════════════════════════════════════════════════════ -->
  {% if data.run.status == "success" %}
  <section>
    {% if data.run.optuna_trials %}<h2>③ 三集表现对比</h2>{% else %}<h2>② 三集表现对比</h2>{% endif %}
    <table>
      <thead>
        <tr>
          <th>数据集</th>
          {% for metric_name in data.run.validation_metrics %}
          <th>{{ metric_name }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        <tr style="background: #f0fdf4;">
          <td><b>验证集</b></td>
          {% for metric_name, metric_val in data.run.validation_metrics.items() %}
          <td>{{ "%.4f"|format(metric_val) }}</td>
          {% endfor %}
        </tr>
        {% if data.run.test_metrics %}
        <tr>
          <td><b>测试集</b></td>
          {% for metric_name in data.run.validation_metrics %}
          <td>
            {% if metric_name in data.run.test_metrics %}
              {{ "%.4f"|format(data.run.test_metrics[metric_name]) }}
            {% else %}<span class="hint">—</span>{% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endif %}
      </tbody>
    </table>

    <h3>最佳参数</h3>
    <div class="param-grid">
      {% for k, v in data.run.best_params.items() %}
      <div class="param-item">
        <div class="name"><code>{{ k }}</code></div>
        <div class="value">{{ v }}</div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer>
    <p>由 TabularX 自动生成 · 模型详情报告</p>
  </footer>
</body>
</html>