<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 模型搜索报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    h3 { color: #2c3e50; margin-top: 1.5rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-info { background: #cce5ff; color: #004085; }
    .badge-drop { background: #f8d7da; color: #721c24; }
    .badge-best { background: #d4edda; color: #155724; font-weight: 700; border: 1px solid #28a745; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .conclusion-best { background: #d4edda; border-left: 4px solid #28a745; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .conclusion-fail { background: #f8d7da; border-left: 4px solid #dc3545; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .75rem 1rem; margin: .75rem 0; border-radius: 4px; font-size: .9rem; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    .bar-chart { margin: 1rem 0; }
    .bar-row { display: flex; align-items: center; margin: .3rem 0; }
    .bar-label { width: 130px; font-size: .85rem; padding-right: .5rem; text-align: right; }
    .bar-fill { height: 22px; border-radius: 3px; transition: width .5s; min-width: 2px; }
    .bar-value { margin-left: .5rem; font-size: .8rem; color: #555; white-space: nowrap; }
    .model-link { text-decoration: none; color: #2980b9; }
    .model-link:hover { text-decoration: underline; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
  </style>
</head>
<body>
  <h1>TabularX 模型搜索报告</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 摘要</h2>

    <h3>输入</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_models_total }}</div><div class="label">尝试模型数</div></div>
      <div class="card"><div class="num">{{ data.n_models_succeeded }}</div><div class="label">成功</div></div>
      <div class="card"><div class="num">{{ data.n_models_failed }}</div><div class="label">失败</div></div>
    </div>

    <h3>配置</h3>
    <table>
      <tr><th>任务类型</th><td>{{ data.task_type }}</td></tr>
      <tr><th>主指标</th><td>{{ data.primary_metric }}</td></tr>
      <tr><th>优化方向</th><td>{{ data.optimization_direction }}</td></tr>
    </table>

    <h3>结论（最优模型）</h3>
    {% if data.best_model_name %}
    <div class="conclusion-best">
      <b>🏆 最优模型：{{ data.best_model_name }}</b>
      <br>
      验证集 {{ data.primary_metric }} = {{ "%.4f"|format(data.best_validation_metrics.get(data.primary_metric, 0)) }}
      {% if data.best_test_metrics %}
        <br>
        测试集 {{ data.primary_metric }} = {{ "%.4f"|format(data.best_test_metrics.get(data.primary_metric, 0)) }}
      {% endif %}
      <br>
      <a class="model-link" href="models/{{ data.best_model_name }}.html">查看详细报告 →</a>
    </div>
    {% else %}
    <div class="conclusion-fail">
      <b>❌ 无成功模型</b>
      <br>所有模型均调参失败，请检查日志。
    </div>
    {% endif %}

    {% if data.ensemble_result and data.ensemble_result.status == "success" %}
    <div class="conclusion">
      <b>🔗 Voting 组合模型</b>
      <br>
      包含模型：{{ data.ensemble_result.note }}
      <br>
      验证集 {{ data.primary_metric }} = {{ "%.4f"|format(data.ensemble_result.validation_metrics.get(data.primary_metric, 0)) }}
      {% if data.ensemble_result.test_metrics %}
        <br>
        测试集 {{ data.primary_metric }} = {{ "%.4f"|format(data.ensemble_result.test_metrics.get(data.primary_metric, 0)) }}
      {% endif %}
      <br>
      <a class="model-link" href="models/voting.html">查看详细报告 →</a>
    </div>
    {% endif %}
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：模型排名（Leaderboard & 柱状图）
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>② 模型排名</h2>

    <h3>2.1 主指标对比（{{ data.primary_metric }}）</h3>

    {% set succeeded = data.succeeded_results %}
    {% if succeeded %}
    {% set best_val = succeeded[0].validation_metrics.get(data.primary_metric, 0) %}
    {% set worst_val = succeeded[-1].validation_metrics.get(data.primary_metric, 0) %}
    {% set range_val = (best_val - worst_val) if data.optimization_direction == "maximize" else (worst_val - best_val) %}
    {% set range_val = range_val if range_val > 0 else 1 %}

    <div class="bar-chart">
      {% for run in succeeded %}
        {% set val = run.validation_metrics.get(data.primary_metric, 0) %}
        {% if data.optimization_direction == "maximize" %}
          {% set pct = ((val - worst_val) / range_val * 80 + 10) %}
        {% else %}
          {% set pct = ((worst_val - val) / range_val * 80 + 10) %}
        {% endif %}
        {% set color = "#28a745" if run.model_name == data.best_model_name else "#3498db" %}
        {% set is_best = "  ← 最优" if run.model_name == data.best_model_name else "" %}
        <div class="bar-row">
          <div class="bar-label">
            {% if data.model_detail_dir %}
            <a class="model-link" href="{{ data.model_detail_dir }}/{{ run.model_name }}.html">{{ run.model_name }}</a>
            {% else %}
            <a class="model-link" href="models/{{ run.model_name }}.html">{{ run.model_name }}</a>
            {% endif %}
          </div>
          <div class="bar-fill" style="width: {{ "%.0f"|format(pct) }}%; background: {{ color }};"></div>
          <span class="bar-value">{{ "%.4f"|format(val) }}{{ is_best }}</span>
        </div>
      {% endfor %}
    </div>
    {% endif %}

    <h3>2.2 详细排名表</h3>
    <table>
      <thead>
        <tr>
          <th>排名</th>
          <th>模型</th>
          <th>状态</th>
          <th>{{ data.primary_metric }}（验证集）</th>
          <th>{{ data.primary_metric }}（测试集）</th>
          <th>调参耗时</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {% for run in data.ranking %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>
            <b>{{ run.model_name }}</b>
            {% if run.model_name == data.best_model_name %}<span class="badge badge-best">最优</span>{% endif %}
          </td>
          <td><span class="badge badge-ok">{{ run.status }}</span></td>
          <td>{{ "%.4f"|format(run.validation_metrics.get(data.primary_metric, 0)) }}</td>
          <td>
            {% if run.test_metrics %}
              {{ "%.4f"|format(run.test_metrics.get(data.primary_metric, 0)) }}
            {% else %}<span class="hint">—</span>{% endif %}
          </td>
          <td>{{ "%.1f"|format(run.optuna_duration_seconds or 0) }}s</td>
          <td>
            {% if data.model_detail_dir %}
            <a class="model-link" href="{{ data.model_detail_dir }}/{{ run.model_name }}.html">详情</a>
            {% else %}
            <a class="model-link" href="models/{{ run.model_name }}.html">详情</a>
            {% endif %}
          </td>
        </tr>
        {% endfor %}

        {% if data.ensemble_result and data.ensemble_result.status == "success" %}
        <tr style="background: #f0fdf4;">
          <td>—</td>
          <td><b>Voting</b> <span class="badge badge-info">组合</span></td>
          <td><span class="badge badge-ok">{{ data.ensemble_result.status }}</span></td>
          <td>{{ "%.4f"|format(data.ensemble_result.validation_metrics.get(data.primary_metric, 0)) }}</td>
          <td>
            {% if data.ensemble_result.test_metrics %}
              {{ "%.4f"|format(data.ensemble_result.test_metrics.get(data.primary_metric, 0)) }}
            {% else %}<span class="hint">—</span>{% endif %}
          </td>
          <td><span class="hint">—</span></td>
          <td>
            {% if data.model_detail_dir %}
            <a class="model-link" href="{{ data.model_detail_dir }}/voting.html">详情</a>
            {% else %}
            <a class="model-link" href="models/voting.html">详情</a>
            {% endif %}
          </td>
        </tr>
        {% endif %}
      </tbody>
    </table>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：失败模型
       ══════════════════════════════════════════════════════════ -->
  {% set failed = data.failed_results %}
  {% if failed %}
  <section>
    <h2>③ 失败模型</h2>
    <table>
      <thead>
        <tr><th>模型</th><th>错误原因</th></tr>
      </thead>
      <tbody>
        {% for run in failed %}
        <tr>
          <td><b>{{ run.model_name }}</b></td>
          <td><span class="hint">{{ run.error }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 4 部分：最优模型参数
       ══════════════════════════════════════════════════════════ -->
  {% if data.best_model_params %}
  <section>
    <h2>④ 最优模型参数（{{ data.best_model_name }}）</h2>
    <table>
      <thead>
        <tr><th>参数名</th><th>值</th></tr>
      </thead>
      <tbody>
        {% for k, v in data.best_model_params.items() %}
        <tr><td><code>{{ k }}</code></td><td>{{ v }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <footer>
    <p>由 TabularX 自动生成 · 模型搜索报告</p>
  </footer>
</body>
</html>