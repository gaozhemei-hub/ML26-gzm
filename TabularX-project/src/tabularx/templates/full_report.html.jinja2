<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TabularX 实验报告</title>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
    window.__mermaid = mermaid;
  </script>
  <style>
    /* ── Reset & Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; overflow: hidden; font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; color: #333; background: #fff; }

    /* ── 翻页容器 ── */
    .deck { width: 100vw; height: 100vh; position: relative; overflow: hidden; }
    .page { width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; overflow-y: auto; padding: 5vh 6vw; display: none; }
    .page.active { display: flex; flex-direction: column; justify-content: flex-start; }
    .page.cover-active, .page.closing-active { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }

    /* ── 导航 ── */
    .nav-arrows { position: fixed; bottom: 2rem; right: 2rem; z-index: 1000; display: flex; gap: .5rem; }
    .nav-arrows button { width: 44px; height: 44px; border: 1px solid #ccc; border-radius: 50%; background: rgba(255,255,255,.9); cursor: pointer; font-size: 1.2rem; color: #555; transition: all .2s; display: flex; align-items: center; justify-content: center; user-select: none; }
    .nav-arrows button:hover { background: #3498db; color: #fff; border-color: #3498db; }
    .nav-arrows button:disabled { opacity: .3; cursor: default; background: rgba(255,255,255,.6); color: #aaa; border-color: #ddd; }

    .page-indicator { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 1000; font-size: .85rem; color: #95a5a6; background: rgba(255,255,255,.85); padding: .3rem 1rem; border-radius: 12px; border: 1px solid #eee; user-select: none; }

    /* ── 进度条 ── */
    .progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: #3498db; z-index: 1001; transition: width .3s ease; }

    /* ── 点击翻页区 ── */
    .click-left, .click-right { position: fixed; top: 0; width: 25vw; height: 100vh; z-index: 500; cursor: pointer; }
    .click-left { left: 0; }
    .click-right { right: 0; }
    .click-left:hover::after, .click-right:hover::after { content: ""; position: absolute; top: 50%; transform: translateY(-50%); width: 0; height: 0; border-style: solid; opacity: .15; }
    .click-left:hover::after { left: 2vw; border-width: 12px 16px 12px 0; border-color: transparent #333 transparent transparent; }
    .click-right:hover::after { right: 2vw; border-width: 12px 0 12px 16px; border-color: transparent transparent transparent #333; }

    /* ── 页面内容 ── */
    .page h1 { font-size: 1.6rem; color: #2c3e50; margin-bottom: .75rem; }
    .page h2 { font-size: 1.3rem; color: #34495e; margin: 1rem 0 .5rem; }
    .page h3 { font-size: 1.05rem; color: #555; margin: .75rem 0 .4rem; }
    .page p { margin: .4rem 0; }
    .page table { border-collapse: collapse; width: 100%; margin: .6rem 0; }
    .page th, .page td { border: 1px solid #ddd; padding: .35rem .5rem; text-align: left; font-size: .85rem; }
    .page th { background: #f5f6fa; font-weight: 600; }
    .page tr:nth-child(even) td { background: #fafbfc; }
    .page .summary { display: flex; gap: .8rem; flex-wrap: wrap; margin: .5rem 0; }
    .page .card { border: 1px solid #ddd; border-radius: 6px; padding: .75rem 1rem; min-width: 100px; flex: 1; }
    .page .card .num { font-size: 1.3rem; font-weight: 700; color: #2c3e50; }
    .page .card .label { font-size: .78rem; color: #7f8c8d; }
    .page .badge { display: inline-block; background: #ecf0f1; border-radius: 3px; padding: .1rem .45rem; margin: .1rem .15rem; font-size: .75rem; }
    .page .badge-warn { background: #fef3cd; color: #856404; }
    .page .badge-ok { background: #d4edda; color: #155724; }
    .page .badge-info { background: #cce5ff; color: #004085; }
    .page .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .5rem .75rem; margin: .6rem 0; border-radius: 4px; font-size: .9rem; }
    .page .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .5rem .75rem; margin: .5rem 0; border-radius: 4px; font-size: .85rem; }
    .page .hint { color: #7f8c8d; font-size: .8rem; }
    .page img { max-width: 100%; height: auto; border: 1px solid #eee; border-radius: 4px; margin: .5rem 0; }
    .page ul, .page ol { padding-left: 1.5rem; margin: .4rem 0; }
    .page li { margin: .2rem 0; font-size: .9rem; }

    /* ── 封面 ── */
    .page-cover { text-align: center; }
    .page-cover h1 { font-size: 2.8rem; color: #2c3e50; margin-bottom: .5rem; }
    .page-cover .subtitle { font-size: 1.2rem; color: #7f8c8d; margin-bottom: 1.5rem; }
    .page-cover .meta { font-size: .95rem; color: #95a5a6; line-height: 2; }

    /* ── 尾页 ── */
    .page-closing { text-align: center; }
    .page-closing h2 { font-size: 1.8rem; color: #2c3e50; margin-bottom: 1rem; }
    .page-closing p { font-size: 1rem; max-width: 560px; line-height: 1.8; color: #7f8c8d; }

    /* ── 标题页眉 ── */
    .page-header { font-size: .75rem; color: #bdc3c7; border-bottom: 1px solid #ecf0f1; padding-bottom: .4rem; margin-bottom: .8rem; display: flex; justify-content: space-between; }
  </style>
</head>
<body>

<div class="progress-bar" id="progressBar"></div>

<!-- ════════════════════════════════════════════════════════════
     翻页容器
     ════════════════════════════════════════════════════════════ -->
<div class="deck" id="deck">

  <!-- ── 封面 ── -->
  <div class="page cover-active page-cover" data-index="0">
    <h1>TabularX 实验报告</h1>
    <p class="subtitle">面向可解释性与可复现性的自动化表格建模</p>
    <div class="meta">
      {% if data.generated_at %}<p>生成时间：{{ data.generated_at }}</p>{% endif %}
      {% if data.task_type %}<p>任务类型：{{ data.task_type }}</p>{% endif %}
      {% if data.dataset_info %}
        <p>
          {% if data.dataset_info.n_rows %}样本数：{{ data.dataset_info.n_rows }} &nbsp;|&nbsp; {% endif %}
          {% if data.dataset_info.n_cols %}特征数：{{ data.dataset_info.n_cols }} &nbsp;|&nbsp; {% endif %}
          {% if data.dataset_info.n_classes %}类别数：{{ data.dataset_info.n_classes }}{% endif %}
        </p>
      {% endif %}
      {% if data.best_model_name %}<p>最佳模型：{{ data.best_model_name }}</p>{% endif %}
      {% if data.audit_summary %}
        <p>
          <span style="color: {% if data.audit_summary.overall_risk_level in ['critical', 'high'] %}#c0392b{% elif data.audit_summary.overall_risk_level == 'medium' %}#b9770e{% else %}#1e8449{% endif %}; font-weight: 600;">
            可信审计综合风险：{{ data.audit_summary.overall_risk_level | upper }}
          </span>
        </p>
      {% endif %}
    </div>
    <p style="margin-top:2rem;color:#bdc3c7;font-size:.85rem;">← 点击左右两侧或按键盘方向键翻页 →</p>
  </div>

  {% if data.audit_summary %}
  <!-- ── 可信审计总览页 ── -->
  <div class="page" data-index="1">
    <div class="page-header">
      <span>可信审计总览</span>
      <span>TabularX</span>
    </div>
    <h1>可信审计总览</h1>

    <div class="summary">
      {% for row in data.audit_summary.stages %}
      <div class="card">
        <div class="num" style="font-size:1rem; color: {% if row.risk_level in ['critical', 'high'] %}#c0392b{% elif row.risk_level == 'medium' %}#b9770e{% else %}#1e8449{% endif %};">
          {{ row.risk_level | upper }}
        </div>
        <div class="label">{{ row.stage }}：{{ row.summary }}</div>
      </div>
      {% endfor %}
    </div>

    {% if data.audit_summary.findings %}
    <h2>风险与发现汇总</h2>
    <table>
      <thead>
        <tr><th style="width:14%;">阶段</th><th style="width:12%;">级别</th><th style="width:24%;">标题</th><th>证据依据</th><th style="width:26%;">处置建议</th></tr>
      </thead>
      <tbody>
        {% for f in data.audit_summary.findings %}
        <tr>
          <td>{{ f.stage }}</td>
          <td>
            <span class="badge {% if f.severity in ['critical', 'high'] %}badge-warn{% else %}badge-info{% endif %}">{{ f.severity }}</span>
          </td>
          <td>{{ f.title }}</td>
          <td>{{ f.evidence }}</td>
          <td>{{ f.recommendation }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="conclusion" style="border-left-color:#27ae60; background:#eafaf1;">
      本次运行在画像与划分两个阶段均未发现泄漏、重复或非法特征风险。
    </div>
    {% endif %}

    {% if data.audit_summary.suggested_actions %}
    <h2>建议动作</h2>
    <ul>
      {% for action in data.audit_summary.suggested_actions %}
      <li>{{ action }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if data.audit_summary.suggested_drop_columns %}
    <h2>建议排除特征</h2>
    <p><code>{{ data.audit_summary.suggested_drop_columns | join(', ') }}</code></p>
    {% endif %}

    <h2>审计链路</h2>
    <div class="mermaid">
flowchart LR
  Raw([原始 X, y]) --> ProfileAudit[画像静态预检<br/>ID / 目标复制 / 目标代理 / 禁用特征]
  ProfileAudit --> ProfileRisk{画像风险等级}
  ProfileRisk -->|critical / high| DropCols[输出建议排除列<br/>供预处理决策参考]
  ProfileRisk -->|info / low / medium| NoDrop[无需排除列]
  DropCols --> SplitAudit
  NoDrop --> SplitAudit[划分完整性审计<br/>重复 / 实体泄漏 / 时间穿越]
  SplitAudit --> SplitRisk{划分风险等级}
  SplitRisk -->|critical| FixSplit[建议改用 group 或 temporal 切分]
  SplitRisk -->|info / medium| KeepSplit[划分方式可接受]
  FixSplit --> Ledger
  KeepSplit --> Ledger[预检结论并入统一报告与交付清单]
  classDef error fill:#f8d7da,stroke:#721c24,stroke-width:1px;
  classDef warning fill:#fff3cd,stroke:#856404,stroke-width:1px;
  classDef audit fill:#e8f4fd,stroke:#2471a3,stroke-width:1px;
  class DropCols,FixSplit warning;
  class ProfileAudit,SplitAudit,ProfileRisk,SplitRisk,Ledger audit;
    </div>
    <p class="hint">↑ 阶段 1（画像）与阶段 2（划分）的审计链路。未声明 group_column / time_column 时，对应检查标记为「未执行」而非通过。</p>
  </div>
  {% endif %}

  <!-- ── 各节 ── -->
  {% set section_offset = 2 if data.audit_summary else 1 %}
  {% for section in data.sections %}
  <div class="page" data-index="{{ loop.index + section_offset - 1 }}">
    <div class="page-header">
      <span>{{ section.title }}</span>
      <span>TabularX</span>
    </div>
    {{ section.body | safe }}
  </div>
  {% endfor %}

  <!-- ── 尾页 ── -->
  <div class="page closing-active page-closing" data-index="{{ data.sections | length + (2 if data.audit_summary else 1) }}">
    <h2>报告结束</h2>
    <p>
      本报告由 <strong>TabularX</strong> 自动生成。<br>
      所有模型训练、评估、可解释性分析及公平性审计均在本地执行。<br>
      如需复现，请保存完整的实验输出目录。
    </p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     导航控件
     ════════════════════════════════════════════════════════════ -->
<div class="click-left" id="clickLeft"></div>
<div class="click-right" id="clickRight"></div>

<div class="nav-arrows">
  <button id="prevBtn" title="上一页 (←)">◀</button>
  <button id="nextBtn" title="下一页 (→)">▶</button>
</div>

<div class="page-indicator" id="pageIndicator">1 / 1</div>

<script>
(function() {
  const pages = document.querySelectorAll('.page');
  const total = pages.length;
  let current = 0;

  function showPage(idx) {
    if (idx < 0 || idx >= total) return;
    pages.forEach((p, i) => {
      p.classList.remove('active', 'cover-active', 'closing-active');
      p.style.display = 'none';
      if (i === idx) {
        p.style.display = 'flex';
        if (i === 0) p.classList.add('cover-active');
        else if (i === total - 1) p.classList.add('closing-active');
        else p.classList.add('active');
      }
    });
    current = idx;
    document.getElementById('prevBtn').disabled = idx === 0;
    document.getElementById('nextBtn').disabled = idx === total - 1;
    document.getElementById('pageIndicator').textContent = (idx + 1) + ' / ' + total;
    document.getElementById('progressBar').style.width = ((idx + 1) / total * 100) + '%';

    // 重新渲染当前页的 Mermaid 流程图（已被隐藏时中断渲染）
    if (window.__mermaid && window.__mermaid.run) {
      const currentPage = pages[idx];
      const mermaidElements = currentPage.querySelectorAll('.mermaid');
      if (mermaidElements.length > 0) {
        window.__mermaid.run({ nodes: mermaidElements });
      }
    }
  }

  function nextPage() { if (current < total - 1) showPage(current + 1); }
  function prevPage() { if (current > 0) showPage(current - 1); }

  // 键盘
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
      e.preventDefault(); nextPage();
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault(); prevPage();
    }
  });

  // 翻页按钮
  document.getElementById('nextBtn').addEventListener('click', nextPage);
  document.getElementById('prevBtn').addEventListener('click', prevPage);

  // 点击左右区域
  document.getElementById('clickRight').addEventListener('click', nextPage);
  document.getElementById('clickLeft').addEventListener('click', prevPage);

  // 触摸滑动
  let touchStartX = 0;
  document.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; });
  document.addEventListener('touchend', function(e) {
    const diff = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) nextPage(); else prevPage();
    }
  });

  showPage(0);
})();
</script>

</body>
</html>