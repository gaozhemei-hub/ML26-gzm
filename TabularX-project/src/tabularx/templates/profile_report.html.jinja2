<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 数据概况报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; background: #ecf0f1; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-info { background: #cce5ff; color: #004085; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 140px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; word-break: break-all; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .75rem 1rem; margin: .75rem 0; border-radius: 4px; font-size: .9rem; }
    .evidence .rule { color: #7f8c8d; font-size: .85rem; margin-top: .25rem; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    .mermaid-note { background: #f5f6fa; border: 1px dashed #bdc3c7; padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: .85rem; color: #7f8c8d; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
    /* Mermaid 流程图样式 */
    .mermaid { background: #fff; padding: 1rem; border-radius: 6px; border: 1px solid #eee; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  </script>
</head>
<body>
  <h1>TabularX 数据概况报告</h1>

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要（输入 / 输出 / 结论）
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>① 摘要</h2>

    <h3>输入</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_rows }}</div><div class="label">样本数（行）</div></div>
      <div class="card"><div class="num">{{ data.n_cols }}</div><div class="label">特征数（列）</div></div>
      <div class="card"><div class="num" style="font-size:1rem">{{ data.fingerprint }}</div><div class="label">数据指纹</div></div>
    </div>

    <h3>输出（结论）</h3>
    <div class="conclusion">
      {% if data.target.task_type == "regression" %}
        判定为 <b>回归任务</b>（目标为连续值）。
      {% else %}
        判定为 <b>{{ data.target.task_type }} 分类任务</b>，
        {% if data.target.n_classes is not none %}共 {{ data.target.n_classes }} 个类别。{% endif %}
      {% endif %}
    </div>

    <h3>关键发现</h3>
    <ul>
      {% set ns = namespace(n_scale=0, n_missing=0, n_constant=0, n_empty=0, n_text=0, n_skewed=0, n_highcard=0) %}
      {% for col in data.columns %}
        {% if "scale_needed" in col.tags %}{% set ns.n_scale = ns.n_scale + 1 %}{% endif %}
        {% if "has_missing" in col.tags %}{% set ns.n_missing = ns.n_missing + 1 %}{% endif %}
        {% if "constant_column" in col.tags %}{% set ns.n_constant = ns.n_constant + 1 %}{% endif %}
        {% if "empty_column" in col.tags %}{% set ns.n_empty = ns.n_empty + 1 %}{% endif %}
        {% if "text" in col.tags %}{% set ns.n_text = ns.n_text + 1 %}{% endif %}
        {% if "skewed" in col.tags %}{% set ns.n_skewed = ns.n_skewed + 1 %}{% endif %}
        {% if "high_cardinality" in col.tags %}{% set ns.n_highcard = ns.n_highcard + 1 %}{% endif %}
      {% endfor %}
      <li>{{ ns.n_scale }} 列建议标准化（scale_needed）</li>
      <li>{{ ns.n_missing }} 列存在缺失值（has_missing）</li>
      <li>{{ ns.n_constant }} 列为常数列、{{ ns.n_empty }} 列为全空列（预处理器将丢弃）</li>
      <li>{{ ns.n_text }} 列为高基数文本列</li>
      <li>{{ ns.n_skewed }} 列分布偏斜（skewed，建议 log 变换或缩尾）</li>
      <li>{{ ns.n_highcard }} 列高基数类别（high_cardinality，建议目标编码）</li>
    </ul>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：判断流程与证据（核心解释）
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>② 判断流程与证据</h2>

    <!-- 2.1 判断流程图 -->
    <h3>2.1 判断流程图</h3>
    <div class="mermaid">
flowchart TD
  Start([开始：接收 X, y]) --> InputCheck{输入类型检查}
  InputCheck -->|X 不是 DataFrame 或 y 不是 Series| InvalidInput[失败：InvalidDataError]
  InputCheck -->|类型正确| ShapeCheck{数据非空检查}
  ShapeCheck -->|X 无行/无列，或 y 无样本| EmptyData[失败：EmptyDataError]
  ShapeCheck -->|数据非空| AlignCheck{X/y 长度检查}
  AlignCheck -->|行数不一致| LengthError[失败：MismatchedLengthError]
  AlignCheck -->|长度一致| TaskCheck{任务类型判断}
  TaskCheck -->|y 全为空| EmptyTarget[失败：EmptyTargetError]
  TaskCheck -->|task_type 非法或无法推断| TaskError[失败：TaskTypeError]
  TaskCheck -->|唯一值 = 2| Binary[二分类任务]
  TaskCheck -->|唯一值 3~20| Multi[多分类任务]
  TaskCheck -->|连续值或浮点且唯一值 > 20| Reg[回归任务]
  Binary --> Imbalance{类别不平衡检测}
  Multi --> Imbalance
  Reg --> ColLoop[逐列分析]
  Imbalance -->|最小类别占比 < 10%| Imbalanced[标记 imbalanced]
  Imbalance -->|否则| Balanced[类别分布较均衡]
  Imbalanced --> ColLoop
  Balanced --> ColLoop
  ColLoop --> EmptyColCheck{是否全空列？}
  EmptyColCheck -->|是：非缺失值 = 0| EmptyColumn[标记 empty_column]
  EmptyColCheck -->|否| ConstantCheck{是否常数列？}
  ConstantCheck -->|是：唯一值 = 1| ConstantColumn[标记 constant_column]
  ConstantCheck -->|否| ColType{列类型判断}
  EmptyColumn --> Done([完成：输出 DataProfile])
  ConstantColumn --> Done
  ColType -->|datetime| DateTime[日期时间列]
  ColType -->|boolean| Boolean[布尔列]
  ColType -->|整数且唯一值 ≤ 20| Cate[类别列]
  ColType -->|整数且唯一值 > 20 或浮点| Num[数值列]
  ColType -->|object/str/category| Cat{唯一值与行唯一率}
  Cat -->|唯一值 > 200 且 >50% 行唯一| Text[文本列]
  Cat -->|其他| Cate
  Cate --> HighCard{基数检测}
  HighCard -->|unique > 50| HighCardYes[标记 high_cardinality]
  HighCard -->|unique ≤ 50| LowCard[基数正常]
  HighCardYes --> Miss{缺失值检查}
  LowCard --> Miss
  Num --> Scale{scale 判据}
  Scale -->|‖mean‖>0.5 或 std>1.5| ScaleYes[标记 scale_needed]
  Scale -->|否则| ScaleNo[无需标准化]
  ScaleYes --> Skew{偏度检测}
  ScaleNo --> Skew
  Skew -->|‖skew‖ > 1| Skewed[标记 skewed]
  Skew -->|否则| NoSkew[分布风险较低]
  Skewed --> Miss{缺失值检查}
  NoSkew --> Miss
  DateTime --> Miss
  Boolean --> Miss
  Text --> Miss
  Miss -->|n_missing > 0| MissYes[标记 has_missing]
  Miss -->|无缺失| Done
  MissYes --> Done
  classDef error fill:#f8d7da,stroke:#721c24,stroke-width:1px;
  classDef warning fill:#fff3cd,stroke:#856404,stroke-width:1px;
  class InvalidInput,EmptyData,LengthError,EmptyTarget,TaskError error;
  class EmptyColumn,ConstantColumn,MissYes,ScaleYes,Skewed,HighCardYes,Imbalanced warning;
    </div>
    <div class="mermaid-note">↑ profile 阶段完整判断流程。后续阶段：Split → Preprocess → Model Search。</div>

    <!-- 2.2 目标变量判断依据 -->
    <h3>2.2 目标变量判断依据</h3>
    <div class="evidence">
      <b>任务类型：{{ data.target.task_type }}</b>
      <ul style="margin: .5rem 0 0 0;">
        {% for ev in data.target.evidences %}
          <li><b>{{ ev.metric }}</b> = <code>{{ ev.value }}</code>
            {% if ev.note %}<span class="hint">— {{ ev.note }}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
      <div class="rule">规则：唯一值 ≤2 → 二分类；3~20 → 多分类；浮点连续且唯一值 &gt;20 → 回归</div>
    </div>

    {% if "imbalanced" in data.target.tags %}
    <div class="evidence" style="border-left-color: #e74c3c;">
      <b>⚠ 类别不平衡</b>
      <br>最小类别占比 {{ "%.2f"|format(data.target.class_balance.values() | min * 100) }}%
      <div class="rule">建议：模型搜索时使用 F1 或 ROC-AUC 作为评估指标，考虑 class_weight="balanced"</div>
    </div>
    {% endif %}

    <!-- 2.3 特征列判断依据（仅列特殊情况的列） -->
    <h3>2.3 特征列判断依据（仅列特殊情况）</h3>
    {% set shown = namespace(count=0) %}
    {% for col in data.columns %}
      {% if col.evidences | length > 1 or "constant_column" in col.tags or "empty_column" in col.tags %}
      <div class="evidence">
        <b>{{ col.col_name }}</b>
        <span class="badge {{ 'badge-warn' if 'scale_needed' in col.tags or 'has_missing' in col.tags or 'constant_column' in col.tags or 'empty_column' in col.tags or 'skewed' in col.tags or 'high_cardinality' in col.tags else '' }}">{{ col.tags | join(', ') }}</span>
        <ul style="margin: .5rem 0 0 0;">
          {% for ev in col.evidences %}
            <li><b>{{ ev.metric }}</b> = <code>{{ ev.value }}</code>
              {% if ev.note %}<span class="hint">— {{ ev.note }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
        {% if "scale_needed" in col.tags %}
          <div class="rule">规则：|mean| &gt; 0.5 或 std &gt; 1.5 → 建议标准化</div>
        {% endif %}
        {% if "constant_column" in col.tags %}
          <div class="rule">规则：唯一值 = 1 → 常数列，预处理器将丢弃</div>
        {% endif %}
        {% if "empty_column" in col.tags %}
          <div class="rule">规则：非缺失值 = 0 → 全空列，预处理器将丢弃</div>
        {% endif %}
        {% if "skewed" in col.tags %}
          <div class="rule">规则：|skew| &gt; 1 → 分布偏斜，建议评估 log 变换或缩尾处理</div>
        {% endif %}
        {% if "high_cardinality" in col.tags %}
          <div class="rule">规则：唯一值 &gt; 50 → 高基数类别，建议使用目标编码或频率编码</div>
        {% endif %}
      </div>
      {% set shown.count = shown.count + 1 %}
      {% endif %}
    {% endfor %}
    {% if shown.count == 0 %}
      <p class="hint">无特殊列（所有列均为常规数值/类别列，无缺失、无需 scale、无常数/空列）。</p>
    {% endif %}
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：详细描述性统计
       ══════════════════════════════════════════════════════════ -->
  <section>
    <h2>③ 详细描述性统计</h2>

    <h3>目标变量</h3>
    <table>
      <tr><th>任务类型</th><td>{{ data.target.task_type }}</td></tr>
      {% if data.target.task_type == "regression" %}
        <tr><th>均值</th><td>{{ "%.4f"|format(data.target.mean) if data.target.mean is not none else "—" }}</td></tr>
        <tr><th>标准差</th><td>{{ "%.4f"|format(data.target.std) if data.target.std is not none else "—" }}</td></tr>
      {% else %}
        <tr><th>类别数</th><td>{{ data.target.n_classes if data.target.n_classes is not none else "—" }}</td></tr>
        <tr><th>类别分布</th>
          <td>
            {% for cls, ratio in data.target.class_balance.items() %}
              <span class="badge badge-info">{{ cls }}: {{ "%.1f"|format(ratio * 100) }}%</span>
            {% endfor %}
          </td>
        </tr>
      {% endif %}
      <tr><th>缺失率</th><td>{{ "%.2f"|format(data.target.missing_rate * 100) }}%</td></tr>
    </table>

    <h3>特征列</h3>
    <table>
      <thead>
        <tr>
          <th>列名</th><th>类型</th><th>dtype</th><th>缺失数</th><th>缺失率</th>
          <th>唯一值</th><th>标签</th><th>均值</th><th>标准差</th>
        </tr>
      </thead>
      <tbody>
        {% for col in data.columns %}
        <tr>
          <td>{{ col.col_name }}</td>
          <td>{{ col.tags[0] if col.tags else "—" }}</td>
          <td>{{ col.dtype }}</td>
          <td>{{ col.n_missing }}</td>
          <td>{{ "%.2f"|format(col.missing_rate * 100) }}%</td>
          <td>{{ col.n_unique }}</td>
          <td>
            {% for tag in col.tags %}
              <span class="badge {{ 'badge-warn' if tag == 'has_missing' or tag == 'scale_needed' or tag == 'constant_column' or tag == 'empty_column' or tag == 'skewed' or tag == 'high_cardinality' else 'badge-ok' if tag == 'numeric' else '' }}">{{ tag }}</span>
            {% endfor %}
          </td>
          <td>{{ "%.4f"|format(col.mean) if col.mean is not none else "—" }}</td>
          <td>{{ "%.4f"|format(col.std) if col.std is not none else "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 4 部分：数据安全与可信泄漏预检（TrustGuard Preflight）
       ══════════════════════════════════════════════════════════ -->
  {% if data.audit is not none %}
  <section>
    <h2>④ 数据安全与泄漏预检</h2>
    <div class="conclusion" style="border-left-color: {% if data.audit.risk_level in ['critical', 'high'] %}#e74c3c; background: #fdf2f2;{% elif data.audit.risk_level == 'medium' %}#f39c12; background: #fef9e7;{% else %}#27ae60; background: #eafaf1;{% endif %}">
      <b>预检风险综合评级：</b>
      <span class="badge {% if data.audit.risk_level in ['critical', 'high'] %}badge-warn{% elif data.audit.risk_level == 'medium' %}badge-warn{% else %}badge-ok{% endif %}" style="font-weight: bold; font-size: 0.95rem;">
        {{ data.audit.risk_level|upper }}
      </span>
      {% if data.audit.high_risk_count > 0 %}
        <span style="color: #c0392b; margin-left: 0.5rem;">发现 <b>{{ data.audit.high_risk_count }}</b> 项高危风险项，建议在预处理中剔除或核验。</span>
      {% else %}
        <span style="color: #27ae60; margin-left: 0.5rem;">未发现严重的数据泄漏或非法特征。</span>
      {% endif %}
    </div>

    <h3>4.1 固定检查项清单</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 25%;">检查项目</th>
          <th style="width: 15%;">状态</th>
          <th>检查结果与依据</th>
        </tr>
      </thead>
      <tbody>
        {% for chk in data.audit.check_results %}
        <tr>
          <td><b>{{ chk.check }}</b></td>
          <td>
            <span class="badge {% if chk.status == '通过' %}badge-ok{% elif chk.status == '发现风险' %}badge-warn{% else %}badge-info{% endif %}">
              {{ chk.status }}
            </span>
          </td>
          <td>{{ chk.result }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if data.audit.findings %}
    <h3>4.2 详细风险与特征发现</h3>
    {% for finding in data.audit.findings %}
    <div class="evidence" style="border-left-color: {% if finding.severity in ['critical', 'high'] %}#e74c3c;{% elif finding.severity == 'medium' %}#f39c12;{% else %}#3498db;{% endif %}">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <b>{{ finding.title }}</b>
        <span class="badge {% if finding.severity in ['critical', 'high'] %}badge-warn{% else %}badge-info{% endif %}">{{ finding.severity }}</span>
      </div>
      <p style="margin: 0.3rem 0;"><b>关联列：</b><code>{{ finding.columns|join(', ') }}</code></p>
      <p style="margin: 0.3rem 0; color: #555;"><b>证据依据：</b>{{ finding.evidence }}</p>
      <p style="margin: 0.3rem 0; color: #2c3e50;"><b>处置建议：</b>{{ finding.recommendation }}</p>
    </div>
    {% endfor %}
    {% endif %}

    {% if data.audit.suggested_drop_columns %}
    <div class="evidence" style="border-left-color: #e67e22; background: #fffaf0;">
      <b>建议排除特征（Suggested Drop Columns）：</b>
      <code>{{ data.audit.suggested_drop_columns|join(', ') }}</code>
      <div class="rule">提示：以上特征在进入实际模型训练前建议剔除，以规避信息泄漏或虚高泛化。</div>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <footer>
    <p>由 TabularX 自动生成 · 数据指纹 {{ data.fingerprint }}</p>
  </footer>
</body>
</html>
