<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>TabularX 数据预处理报告</title>
  <style>
    body { font-family: "Helvetica Neue", Arial, "Microsoft YaHei", sans-serif; margin: 2rem; color: #333; line-height: 1.6; }
    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: .5rem; }
    h2 { color: #34495e; margin-top: 2rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; font-size: .9rem; }
    th { background: #f5f6fa; font-weight: 600; }
    tr:nth-child(even) td { background: #fafbfc; }
    .badge { display: inline-block; background: #ecf0f1; border-radius: 3px; padding: .1rem .5rem; margin: .1rem .2rem; font-size: .8rem; }
    .badge-warn { background: #fef3cd; color: #856404; }
    .badge-ok { background: #d4edda; color: #155724; }
    .badge-info { background: #cce5ff; color: #004085; }
    .badge-drop { background: #f8d7da; color: #721c24; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; min-width: 120px; }
    .card .num { font-size: 1.5rem; font-weight: 700; color: #2c3e50; }
    .card .label { font-size: .8rem; color: #7f8c8d; }
    .conclusion { background: #eaf4fd; border-left: 4px solid #3498db; padding: .75rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .evidence { background: #f8f9fa; border: 1px solid #eee; border-left: 3px solid #27ae60; padding: .75rem 1rem; margin: .75rem 0; border-radius: 4px; font-size: .9rem; }
    .evidence .rule { color: #7f8c8d; font-size: .85rem; margin-top: .25rem; }
    .hint { color: #7f8c8d; font-size: .85rem; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #95a5a6; font-size: .85rem; }
    /* Mermaid 流程图样式 */
    .mermaid { background: #fff; padding: 1rem; border-radius: 6px; border: 1px solid #eee; }
    .mermaid-note { background: #f5f6fa; border: 1px dashed #bdc3c7; padding: 1rem; border-radius: 6px; margin: 1rem 0; font-size: .85rem; color: #7f8c8d; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  </script>
</head>
<body>
  <h1>TabularX 数据预处理报告</h1>

  {# 章节序号按实际渲染的 section 动态分配：
     「列映射关系」与「分布漂移与群体覆盖审计」都是条件渲染，
     固定编号会导致后续断号，因此主序号与子序号都动态递增。 #}
  {% set numbering = namespace(n=0) %}

  <!-- ══════════════════════════════════════════════════════════
       第 1 部分：摘要
       ══════════════════════════════════════════════════════════ -->
  {% set numbering.n = numbering.n + 1 %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 摘要</h2>

    <h3>输入 / 输出</h3>
    <div class="summary">
      <div class="card"><div class="num">{{ data.n_features_in }}</div><div class="label">输入特征数</div></div>
      <div class="card"><div class="num">{{ data.n_features_out }}</div><div class="label">输出特征数</div></div>
      <div class="card"><div class="num">{{ data.dropped_columns | length }}</div><div class="label">丢弃列数</div></div>
      <div class="card"><div class="num">{{ data.X_train.shape[0] }}</div><div class="label">训练集样本数</div></div>
      <div class="card"><div class="num">{{ data.X_valid.shape[0] }}</div><div class="label">验证集样本数</div></div>
      <div class="card"><div class="num">{{ data.X_test.shape[0] }}</div><div class="label">测试集样本数</div></div>
    </div>

    <h3>关键结论</h3>
    <div class="conclusion">
      {% if data.dropped_columns %}
        丢弃了 <b>{{ data.dropped_columns | length }}</b> 列：<code>{{ data.dropped_columns | join(", ") }}</code>
      {% else %}
        没有列因常数列、空列或文本列被丢弃。
      {% endif %}
      <br>
      {% if data.excluded_by_audit %}
        因审计建议或分组声明排除了 <b>{{ data.excluded_by_audit | length }}</b> 列：
        <code>{{ data.excluded_by_audit | join(", ") }}</code>
      {% else %}
        没有列因审计建议被排除。
      {% endif %}
      <br>
      {% if data.n_features_in != data.n_features_out %}
        特征数量从 <b>{{ data.n_features_in }}</b> 变为 <b>{{ data.n_features_out }}</b>
        （{{ "增加" if data.n_features_out > data.n_features_in else "减少" }}
        了 {{ (data.n_features_out - data.n_features_in) | abs }} 列）。
      {% else %}
        特征数量保持 <b>{{ data.n_features_out }}</b> 列不变。
      {% endif %}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 2 部分：判断流程
       ══════════════════════════════════════════════════════════ -->
  {% set numbering.n = numbering.n + 1 %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 判断流程</h2>

    <div class="mermaid">
flowchart TD
  Start([开始：接收 X, y, profile, split_result, config, sensitive_features]) --> Slice[阶段 1：切片数据]
  Slice -->|提取 train/valid/test 索引| AuditDrop[阶段 2：解析审计排除列<br/>分组列 + 画像建议列]

  AuditDrop --> ColLoop[阶段 3：逐列处理]

  ColLoop --> AuditExcluded{在审计排除集合中？}
  AuditExcluded -->|是| DropAudit[排除此列<br/>记录 dropped_by_audit 与原因]
  AuditExcluded -->|否| EmptyCol{常数列或全空列？}
  EmptyCol -->|是| Drop[丢弃此列]
  EmptyCol -->|否| TextCol{文本列？}
  TextCol -->|是，handle_text=drop| Drop
  TextCol -->|是，handle_text=keep| TextError[报错：暂不支持 NLP]
  TextCol -->|否| DtCol{日期列？}
  DtCol -->|handle_datetime=drop| Drop
  DtCol -->|handle_datetime=keep| Keep[原样保留]
  DtCol -->|handle_datetime=extract| DtExtract[提取年/月/日数值特征]

  Drop --> NextCol
  DropAudit --> NextCol
  TextError --> NextCol
  Keep --> NextCol
  DtExtract --> NextCol

  DtCol -->|否| NumCol{数值列？}
  NumCol -->|是| NumImpute[填补缺失值]
  NumImpute --> ScaleQuery{需要标准化？}
  ScaleQuery -->|是| SkewQuery1{分布偏斜？}
  ScaleQuery -->|否| SkewQuery2{分布偏斜？}
  SkewQuery1 -->|是| YeoJohnson[Yeo-Johnson 变换<br/>兼作标准化]
  SkewQuery1 -->|否| Scale[标准化]
  SkewQuery2 -->|是| YeoJohnson2[Yeo-Johnson 变换]
  SkewQuery2 -->|否| NoOp[无需处理]
  YeoJohnson --> NextCol
  Scale --> NextCol
  YeoJohnson2 --> NextCol
  NoOp --> NextCol

  NumCol -->|否| BoolCol{布尔列？}
  BoolCol -->|是| BoolProc["填补缺失 转 int(0/1)"]
  BoolProc --> NextCol
  BoolCol -->|否| CateCol{类别列？}
  CateCol -->|是| CateImpute[填补缺失值]
  CateImpute --> HighCard{高基数？}
  HighCard -->|unique > max_onehot_categories| HighEnc{高基数编码}
  HighEnc -->|target| TargetEncode[目标编码]
  HighEnc -->|frequency| FreqEncode[频率编码]
  HighCard -->|否| LowEnc{低基数编码}
  LowEnc -->|onehot| OneHot[OneHot 编码]
  LowEnc -->|label| LabelEncode[标签编码]
  TargetEncode --> NextCol
  FreqEncode --> NextCol
  OneHot --> NextCol
  LabelEncode --> NextCol

  CateCol -->|否| Unknown[未知类型 原样保留]
  Unknown --> NextCol

  NextCol{还有下一列？}
  NextCol -->|是| ColLoop
  NextCol -->|否| DriftAudit[阶段 4：分布漂移审计<br/>train vs valid / train vs test]
  DriftAudit --> KsGate{KS 是否超过同样本量临界值？}
  KsGate -->|否| DriftInfo[判为 info：差异在抽样噪声内]
  KsGate -->|是| PsiGate{PSI / TVD 等级}
  PsiGate -->|≥ high 阈值| DriftHigh[判为 high：记录漂移特征]
  PsiGate -->|≥ warning 阈值| DriftMed[判为 medium]
  PsiGate -->|低于阈值| DriftLow[判为 info]
  DriftHigh --> GroupAudit
  DriftMed --> GroupAudit
  DriftLow --> GroupAudit
  DriftInfo --> GroupAudit
  GroupAudit[阶段 5：敏感群体覆盖审计] --> Done([完成：输出 PreprocessedData + audit])

  classDef error fill:#f8d7da,stroke:#721c24,stroke-width:1px;
  classDef decision fill:#fff3cd,stroke:#856404,stroke-width:1px;
  classDef audit fill:#e8f4fd,stroke:#2471a3,stroke-width:1px;
  classDef warning fill:#fff3cd,stroke:#856404,stroke-width:1px;
  class Drop,TextError error;
  class DropAudit,DriftHigh warning;
  class EmptyCol,TextCol,DtCol,NumCol,BoolCol,CateCol,ScaleQuery,SkewQuery1,SkewQuery2,HighCard,HighEnc,LowEnc,AuditExcluded,KsGate,PsiGate decision;
  class AuditDrop,DriftAudit,DriftInfo,DriftMed,DriftLow,GroupAudit audit;
    </div>
    <div class="mermaid-note">↑ preprocess 阶段决策流程：先解析审计排除列，再逐列变换，最后做分布漂移与群体覆盖审计。灰色背景节点为决策分支，蓝色为审计算子，红色为错误出口。漂移判定需先通过同样本量下的 KS 显著性门槛。</div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 3 部分：逐列变换记录
       ══════════════════════════════════════════════════════════ -->
  {% set numbering.n = numbering.n + 1 %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 逐列变换记录</h2>

    {% set ns = namespace(n_scale=0, n_impute=0, n_encode=0, n_drop=0) %}
    {% for t in data.transforms %}
      {% if "scale" in t.action_sequence | join(" ") %}{% set ns.n_scale = ns.n_scale + 1 %}{% endif %}
      {% if "impute" in t.action_sequence | join(" ") %}{% set ns.n_impute = ns.n_impute + 1 %}{% endif %}
      {% if "encode" in t.action_sequence | join(" ") %}{% set ns.n_encode = ns.n_encode + 1 %}{% endif %}
      {% if t.dropped %}{% set ns.n_drop = ns.n_drop + 1 %}{% endif %}
    {% endfor %}

    <p class="hint">
      总计 {{ data.transforms | length }} 列 · 
      标准化 {{ ns.n_scale }} 列 · 填补 {{ ns.n_impute }} 列 · 编码 {{ ns.n_encode }} 列 · 丢弃 {{ ns.n_drop }} 列
    </p>

    <table>
      <thead>
        <tr>
          <th>列名</th>
          <th>原始 dtype</th>
          <th>原始唯一值</th>
          <th>变换动作</th>
          <th>输出特征数</th>
          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for t in data.transforms %}
        <tr>
          <td><b>{{ t.col_name }}</b></td>
          <td><code>{{ t.original_dtype }}</code></td>
          <td>{{ t.original_n_unique }}</td>
          <td>
            {% if t.dropped %}
              <span class="badge badge-drop">丢弃</span>
            {% elif t.action_sequence | length == 0 or t.action_sequence[0] == "kept" %}
              <span class="badge badge-ok">保留</span>
            {% else %}
              {% for act in t.action_sequence %}
                <span class="badge {{ 'badge-warn' if 'impute' in act else 'badge-ok' if 'scale' in act or 'yeo' in act or 'log1p' in act else 'badge-info' }}">{{ act }}</span>
              {% endfor %}
            {% endif %}
          </td>
          <td>{{ t.n_features_out }}</td>
          <td class="hint">{{ t.note or "" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       第 4 部分：列映射关系（变换追踪）
       ══════════════════════════════════════════════════════════ -->
  {% set changed_mappings = [] %}
  {% for m in data.column_mappings %}
    {% if m.is_dropped or m.output_names != [m.original_name] %}
      {% set _ = changed_mappings.append(m) %}
    {% endif %}
  {% endfor %}

  {% if changed_mappings | length > 0 %}
  {% set numbering.n = numbering.n + 1 %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 列映射关系</h2>
    <p class="hint">仅展示有变化的列（被丢弃、展开、重命名或提取）。未列出的列原样保留。</p>

    <table>
      <thead>
        <tr>
          <th>原始列名</th>
          <th>变换后列名</th>
          <th>输出特征数</th>
          <th>状态</th>
        </tr>
      </thead>
      <tbody>
        {% for m in changed_mappings %}
        <tr>
          <td><b>{{ m.original_name }}</b></td>
          <td>
            {% if m.is_dropped %}
              <span class="hint">—（已丢弃）</span>
            {% else %}
              {% for out_name in m.output_names %}
                <span class="badge badge-info">{{ out_name }}</span>
              {% endfor %}
            {% endif %}
          </td>
          <td>{{ m.n_features_out }}</td>
          <td>
            {% if m.is_dropped %}
              <span class="badge badge-drop">丢弃</span>
            {% elif m.output_names | length > 1 %}
              <span class="badge badge-ok">展开</span>
            {% elif m.output_names | length == 1 and m.output_names[0] != m.original_name %}
              <span class="badge badge-warn">变换</span>
            {% else %}
              <span class="badge badge-ok">保留</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 5 部分：分布漂移与群体覆盖审计（阶段 3 新增）
       ══════════════════════════════════════════════════════════ -->
  {% if data.audit is not none %}
  {% set numbering.n = numbering.n + 1 %}
  {% set sub = namespace(n=0) %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 分布漂移与群体覆盖审计</h2>

    <div class="conclusion" style="border-left-color: {% if data.audit.risk_level in ['critical', 'high'] %}#e74c3c; background: #fdf2f2;{% elif data.audit.risk_level == 'medium' %}#f39c12; background: #fef9e7;{% else %}#27ae60; background: #eafaf1;{% endif %}">
      <b>审计风险综合评级：</b>
      <span class="badge {% if data.audit.risk_level in ['critical', 'high', 'medium'] %}badge-warn{% else %}badge-ok{% endif %}" style="font-weight: bold;">
        {{ data.audit.risk_level|upper }}
      </span>
      {% if data.audit.high_drift_features %}
        <span style="color: #c0392b; margin-left: 0.5rem;">
          <b>{{ data.audit.high_drift_features | length }}</b> 个特征漂移偏高，
          最大 PSI = <b>{{ data.audit.max_psi }}</b>。
        </span>
      {% else %}
        <span style="color: #27ae60; margin-left: 0.5rem;">
          {{ data.audit.audited_features }} 个特征在验证集与测试集方向上均未出现显著漂移。
        </span>
      {% endif %}
      {% if data.audit.drift_truncated %}
        <br><span class="hint">受 drift_max_features 限制，本次只审计了部分特征。</span>
      {% endif %}
    </div>

    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 固定检查项清单</h3>
    <table>
      <thead>
        <tr><th style="width: 25%;">检查项目</th><th style="width: 15%;">状态</th><th>检查结果与依据</th></tr>
      </thead>
      <tbody>
        {% for chk in data.audit.check_results %}
        <tr>
          <td><b>{{ chk.check }}</b></td>
          <td>
            <span class="badge {% if chk.status == '通过' %}badge-ok{% elif chk.status == '发现风险' %}badge-warn{% else %}badge-info{% endif %}">
              {{ chk.status }}
            </span>
          </td>
          <td>{{ chk.result }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if data.excluded_by_audit %}
    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 因审计排除的列</h3>
    <div class="evidence" style="border-left-color: #e67e22; background: #fffaf0;">
      <code>{{ data.excluded_by_audit | join(", ") }}</code>
      <ul style="margin: .4rem 0 0 1.1rem;">
        {% for t in data.transforms %}
          {% if "dropped_by_audit" in t.action_sequence %}
          <li><b>{{ t.col_name }}</b>：{{ t.note }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% set drift = namespace(n_high=0, n_medium=0) %}
    {% for r in data.audit.drift_records %}
      {% if r.severity == 'high' %}{% set drift.n_high = drift.n_high + 1 %}{% endif %}
      {% if r.severity == 'medium' %}{% set drift.n_medium = drift.n_medium + 1 %}{% endif %}
    {% endfor %}
    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 特征分布漂移</h3>
    <p class="hint">
      共 {{ data.audit.drift_records | length }} 条记录（每个特征两个对比方向）·
      高危 {{ drift.n_high }} 条 · 中危 {{ drift.n_medium }} 条 ·
      判定前先校验同样本量下的 KS 显著性，避免小样本噪声被当作漂移
    </p>
    {% if data.audit.skipped_columns %}
    <p class="hint">
      以下列已被排除出模型输入，未参与漂移审计（其分布差异不影响建模）：
      <code>{{ data.audit.skipped_columns | join(", ") }}</code>
    </p>
    {% endif %}
    <table>
      <thead>
        <tr>
          <th>特征</th><th>类型</th><th>对比方向</th><th>PSI</th><th>KS</th>
          <th>TVD</th><th>未见类别率</th><th>判定</th><th>说明</th>
        </tr>
      </thead>
      <tbody>
        {% for r in data.audit.drift_records %}
          {% if r.severity != 'info' %}
          <tr>
            <td><b>{{ r.feature }}</b></td>
            <td>{{ r.feature_type }}</td>
            <td>{{ r.comparison }}</td>
            <td>{{ "%.4f"|format(r.psi) if r.psi is not none else "—" }}</td>
            <td>{{ "%.4f"|format(r.ks_statistic) if r.ks_statistic is not none else "—" }}</td>
            <td>{{ "%.4f"|format(r.total_variation) if r.total_variation is not none else "—" }}</td>
            <td>{{ "%.4f"|format(r.unseen_rate) if r.unseen_rate is not none else "—" }}</td>
            <td><span class="badge badge-warn">{{ r.severity }}</span></td>
            <td class="hint">{{ r.recommendation }}</td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
    {% if drift.n_high == 0 and drift.n_medium == 0 %}
      <p class="hint">所有特征的漂移判定均为 info（通过显著性门槛且未超阈值）。</p>
    {% endif %}

    {% if data.audit.group_coverage %}
    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 敏感群体覆盖</h3>
    <table>
      <thead>
        <tr><th>敏感特征</th><th>群体</th><th>子集</th><th>样本数</th><th>占比</th><th>判定</th></tr>
      </thead>
      <tbody>
        {% for g in data.audit.group_coverage %}
        <tr>
          <td>{{ g.sensitive_feature }}</td>
          <td>{{ g.group }}</td>
          <td>{{ g.split }}</td>
          <td>{{ g.count }}</td>
          <td>{{ "%.2f"|format(g.proportion * 100) }}%</td>
          <td>
            <span class="badge {% if g.severity == 'high' %}badge-warn{% else %}badge-ok{% endif %}">{{ g.severity }}</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 敏感群体覆盖</h3>
    <p class="hint">未提供敏感特征，本次未执行群体覆盖审计。如需该检查，请调用 <code>fit(X, y, sensitive_features=[...])</code>。</p>
    {% endif %}

    {% if data.audit.findings %}
    {% set sub.n = sub.n + 1 %}
    <h3>{{ numbering.n }}.{{ sub.n }} 风险详情</h3>
    {% for finding in data.audit.findings %}
    <div class="evidence" style="border-left-color: {% if finding.severity in ['critical', 'high'] %}#e74c3c;{% elif finding.severity == 'medium' %}#f39c12;{% else %}#3498db;{% endif %}">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <b>{{ finding.title }}</b>
        <span class="badge {% if finding.severity in ['critical', 'high'] %}badge-warn{% else %}badge-info{% endif %}">{{ finding.severity }}</span>
      </div>
      <p style="margin: 0.3rem 0; color: #555;"><b>证据依据：</b>{{ finding.evidence }}</p>
      <p style="margin: 0.3rem 0; color: #2c3e50;"><b>处置建议：</b>{{ finding.recommendation }}</p>
    </div>
    {% endfor %}
    {% endif %}
  </section>
  {% endif %}

  <!-- ══════════════════════════════════════════════════════════
       第 6 部分：数据概况（各子集统计）
       ══════════════════════════════════════════════════════════ -->
  {% set numbering.n = numbering.n + 1 %}
  <section>
    <h2>{{ "①②③④⑤⑥⑦⑧⑨"[numbering.n - 1] }} 数据概况</h2>

    <h3>输出特征名</h3>
    <p>
      {% for name in data.feature_names_out %}
        <span class="badge badge-info">{{ name }}</span>
      {% endfor %}
    </p>

    <h3>训练集描述性统计</h3>
    <table>
      <thead>
        <tr>
          <th>列名</th>
          <th>均值</th>
          <th>标准差</th>
          <th>最小值</th>
          <th>最大值</th>
        </tr>
      </thead>
      <tbody>
        {% for col_name in data.feature_names_out %}
          {% set col = data.X_train[col_name] %}
          {% if col.dtype in ['float64', 'int64', 'float32', 'int32'] %}
          <tr>
            <td>{{ col_name }}</td>
            <td>{{ "%.4f"|format(col.mean()) }}</td>
            <td>{{ "%.4f"|format(col.std()) }}</td>
            <td>{{ "%.4f"|format(col.min()) }}</td>
            <td>{{ "%.4f"|format(col.max()) }}</td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>
    <p>由 TabularX 自动生成 · Preprocess 报告</p>
  </footer>
</body>
</html>